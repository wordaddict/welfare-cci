# Production profile
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-long-random-secret
APP_BASE_URL=https://your-app-name.herokuapp.com

# Heroku sets DATABASE_URL automatically when Postgres is attached
DATABASE_URL=postgresql://username:password@host:5432/database
DATABASE_SSL=true

# Recommended storage, closer to cci
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER_PREFIX=cci-welfare

# Recommended email, closer to cci
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=CCI America Financial Assistance <no-reply@your-domain.com>

# Fallback email options
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CCI America Financial Assistance <no-reply@your-domain.com>
DISABLE_EMAIL_NOTIFICATIONS=false

ADMIN_BOOTSTRAP_NAME=CCI Welfare Admin
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password
ADMIN_EMAIL=admin@your-domain.com
FINANCE_TEAM_NAME=CCI USA Finance Team
FINANCE_TEAM_EMAIL=finance@your-domain.com

AUTO_ASSIGN_REVIEWERS=false
REVIEWER_SWEEP_INTERVAL_MINUTES=15
DISABLE_REVIEWER_SCHEDULER=false
RUN_SCHEDULERS=true

# Use these when webhook or QStash job triggering is desired
INTERNAL_JOB_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_SKIP_URL_VERIFICATION=false

FOLLOWUP_CLOSEOUT_DELAY_DAYS=3
FOLLOWUP_REMINDER_INTERVAL_DAYS=7
CLOSEOUT_SWEEP_INTERVAL_MINUTES=60
DISABLE_CLOSEOUT_SCHEDULER=false
