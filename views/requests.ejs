<%- include('partials_header') %>
<div class="page-heading"><p class="eyebrow">Committee review</p><h1 class="section-title">Financial Assistance Requests</h1></div><div class="card"><form class="filters"><label>Status<select name="status"><option value="">All</option><% [['New Request','New Request'],['Intake Review','Intake Review'],['Missing Information','Missing Information'],['Awaiting Leadership Verification','Awaiting Leadership Verification'],['Leadership Verification Complete','Leadership Verification Complete'],['Awaiting Pastoral Verification','Awaiting Pastoral Verification'],['Pastoral Verification Complete','Pastoral Verification Complete'],['Awaiting Leader Verification','Pastoral Verification (legacy)'],['Leader Verification Complete','Pastoral Verification Complete (legacy)'],['Assigned to Reviewers','Assigned to Reviewers'],['Committee Review','Committee Review'],['Decision Made','Decision Made'],['Escalated to Pastorate','Escalated to Pastorate'],['Follow-Up Needed','Follow-Up Needed'],['Closed','Closed']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= status===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Category<select name="category"><option value="">All</option><% ['Rent or Housing','Utilities','Groceries or Food','Medical or Health-Related Support','Tuition or Education','Emergency Accommodation','Special CCI Event Support','Other Exceptional Need'].forEach(x=>{ %><option <%= category===x?'selected':'' %>><%= x %></option><% }) %></select></label><button class="btn small">Filter</button></form></div>
<div class="card"><table><thead><tr><th>Case</th><th>Submitted</th><th>Applicant</th><th>Category</th><th>Requested</th><th>Due</th><th>Urgency</th><th>Status</th><th></th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><%= r.case_id %></td><td><%= r.created_at?.slice(0,10) %></td><td><%= r.full_name %></td><td><%= r.request_category %></td><td><%= money(r.amount_requested) %></td><td><%= r.due_date || '' %></td><td><span class="tag <%= r.urgency==='Emergency'?'danger':(r.urgency==='Urgent'?'warning':'') %>"><%= r.urgency %></span></td><td><%= r.status === 'Awaiting Leader Verification' ? 'Awaiting Pastoral Verification' : (r.status === 'Leader Verification Complete' ? 'Pastoral Verification Complete' : r.status) %></td><td><a href="/requests/<%= r.id %>">Open</a></td></tr><% }) %></tbody></table></div>
<%- include('partials_footer') %>
