<%- include('partials_header') %>
<h1 class="section-title">Reports</h1><p><a class="btn small" href="/reports/export.csv">Export CSV</a></p><div class="grid"><section class="card"><h2>By Category</h2><table><thead><tr><th>Category</th><th>Count</th><th>Requested</th><th>Approved</th></tr></thead><tbody><% byCategory.forEach(r=>{ %><tr><td><%= r.request_category %></td><td><%= r.count %></td><td><%= money(r.requested) %></td><td><%= money(r.approved) %></td></tr><% }) %></tbody></table></section><section class="card"><h2>By Status</h2><table><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody><% byStatus.forEach(r=>{ %><tr><td><%= r.status %></td><td><%= r.count %></td></tr><% }) %></tbody></table></section><section class="card"><h2>By Month</h2><table><thead><tr><th>Month</th><th>Count</th><th>Approved</th></tr></thead><tbody><% byMonth.forEach(r=>{ %><tr><td><%= r.month %></td><td><%= r.count %></td><td><%= money(r.approved) %></td></tr><% }) %></tbody></table></section></div>
<%- include('partials_footer') %>
