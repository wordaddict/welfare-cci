<%- include('partials_header') %>
<div class="admin-directory-shell">
  <section class="page-heading admin-directory-heading">
    <div>
      <p class="eyebrow dark">Admin</p>
      <h1>Login Accounts</h1>
      <p class="muted">Only Applicants and Admins use password-based login. Reviewer contacts are managed separately under <a href="/admin/reviewers">Reviewer Directory</a>.</p>
    </div>
    <div class="admin-directory-summary">
      <strong><%= users.length %></strong>
      <span><%= users.length === 1 ? 'login account' : 'login accounts' %></span>
    </div>
  </section>

  <% if (error) { %><p class="alert"><%= error %></p><% } %>

  <div class="admin-directory-grid">
    <section class="card panel-card admin-directory-panel">
      <div class="admin-directory-panel-copy">
        <h2>Create Login Account</h2>
        <p class="muted small">Use this for Admin or Applicant access. Reviewer access continues to run through secure email links instead.</p>
      </div>
      <form method="post" action="/admin/users" class="stacked-form">
        <label>Name<input name="name" required></label>
        <label>Email<input name="email" type="email" required></label>
        <label>Password<input name="password" type="password" minlength="8" required></label>
        <label>Role<select name="role" required><option value="applicant">Applicant</option><option value="admin">Admin</option></select></label>
        <button class="btn">Create Account</button>
      </form>
    </section>

    <section class="card panel-card admin-directory-panel">
      <div class="admin-directory-panel-copy">
        <h2>Existing Login Accounts</h2>
        <p class="muted small">Review active password-based accounts and quickly disable access when someone should no longer sign in.</p>
      </div>
      <% if (!users.length) { %><div class="empty-state"><b>No login accounts yet.</b><p>Create the first Admin or Applicant account using the form.</p></div><% } %>
      <% if (users.length) { %>
        <div class="directory-list">
          <% users.forEach(u => { %>
            <article class="directory-list-item directory-list-item--compact">
              <div class="directory-list-main">
                <div class="directory-list-top">
                  <div class="directory-list-identity">
                    <h3><%= u.name %></h3>
                    <p><%= u.email %></p>
                  </div>
                  <div class="directory-inline-pills">
                    <span class="directory-pill <%= u.role === 'admin' ? 'directory-pill--role-admin' : 'directory-pill--role-applicant' %>"><%= u.role === 'admin' ? 'Admin' : 'Applicant' %></span>
                    <span class="directory-pill <%= u.active ? 'directory-pill--success' : 'directory-pill--muted' %>"><%= u.active ? 'Active' : 'Inactive' %></span>
                  </div>
                </div>
              </div>
              <div class="directory-list-actions">
                <form method="post" action="/admin/users/<%= u.id %>/toggle">
                  <button class="btn btn-soft directory-action-btn"><%= u.active ? 'Deactivate' : 'Activate' %></button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>
<%- include('partials_footer') %>
