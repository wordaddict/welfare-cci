# Core app
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-before-real-use

# Public URL used inside emailed links.
# Local: http://localhost:3000
# Production: https://welfare.yourdomain.org
# On Render, the app can also fall back to RENDER_EXTERNAL_URL.
APP_BASE_URL=http://localhost:3000

# Persistent storage paths.
# Keep the defaults for local use. On a hosted server with a persistent disk,
# point all three to that mounted disk, for example /var/data/...
DATABASE_PATH=./db/financial_support.sqlite
SESSION_DIR=./db
UPLOAD_DIR=./uploads

# Initial production Admin bootstrap.
# Used only when there is no active Admin in the database.
# Use a strong 12+ character password in production.
ADMIN_BOOTSTRAP_NAME=CCI Welfare Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email / SMTP. If SMTP_HOST is blank, emails are previewed in Terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CCI America Financial Assistance <no-reply@cciamerica.org>

# Operational notification addresses
ADMIN_EMAIL=admin@cci.local
FINANCE_TEAM_NAME=CCI USA Finance Team
FINANCE_TEAM_EMAIL=finance@cci.local

# Reviewer workflow
# false = Admin manually assigns reviewers from Reviewer Directory (recommended)
# true = system may fill missing reviewer slots from active reviewer contacts
AUTO_ASSIGN_REVIEWERS=false
REVIEWER_SWEEP_INTERVAL_MINUTES=15
DISABLE_REVIEWER_SCHEDULER=false

# Applicant close-out workflow
FOLLOWUP_CLOSEOUT_DELAY_DAYS=3
FOLLOWUP_REMINDER_INTERVAL_DAYS=7
CLOSEOUT_SWEEP_INTERVAL_MINUTES=60
DISABLE_CLOSEOUT_SCHEDULER=false
