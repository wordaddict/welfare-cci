# Core app
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-before-real-use

# Public URL used inside emailed links.
# Local: http://localhost:3000
# Production / Heroku: https://your-app-name.herokuapp.com
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string.
# Heroku sets DATABASE_URL automatically when Heroku Postgres is attached.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cci_welfare
DATABASE_SSL=false

# Cloudinary file storage (recommended, closer to cci)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=cci-welfare

# Initial production Admin bootstrap.
# Used only when there is no active Admin in the database.
# Use a strong 12+ character password in production.
ADMIN_BOOTSTRAP_NAME=CCI Welfare Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email.
# Option A: Resend (closest to cci)
RESEND_API_KEY=
FROM_EMAIL=CCI America Financial Assistance <no-reply@cciamerica.org>

# Option B: set SENDGRID_API_KEY and the app will use SendGrid SMTP automatically.
SENDGRID_API_KEY=

# Option B: set SMTP_HOST/SMTP_USER/SMTP_PASS for another SMTP provider.
# If neither Resend nor SMTP is configured, emails are previewed in Terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CCI America Financial Assistance <no-reply@cciamerica.org>
DISABLE_EMAIL_NOTIFICATIONS=false

# Operational notification addresses
ADMIN_EMAIL=admin@cci.local
FINANCE_TEAM_NAME=CCI USA Finance Team
FINANCE_TEAM_EMAIL=finance@cci.local

# Reviewer workflow
# false = Admin manually assigns reviewers from Reviewer Directory (recommended)
# true = system may fill missing reviewer slots from active reviewer contacts
AUTO_ASSIGN_REVIEWERS=false
REVIEWER_SWEEP_INTERVAL_MINUTES=15
DISABLE_REVIEWER_SCHEDULER=false
RUN_SCHEDULERS=true

# Optional webhook/authenticated scheduler triggers
INTERNAL_JOB_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_SKIP_URL_VERIFICATION=false

# Applicant close-out workflow
FOLLOWUP_CLOSEOUT_DELAY_DAYS=3
FOLLOWUP_REMINDER_INTERVAL_DAYS=7
CLOSEOUT_SWEEP_INTERVAL_MINUTES=60
DISABLE_CLOSEOUT_SCHEDULER=false
